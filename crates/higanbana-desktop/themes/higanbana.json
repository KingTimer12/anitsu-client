        "table.background": "#07070a",
        "table.head.foreground": "#9a9ea8",
        "table.row.border": "#ffffff0f",

        "base.red": "#e8283c",
        "base.red.light": "#ff7a85",
        "base.green": "#4ade80",
        "base.green.light": "#86efac",
        "base.blue": "#60a5fa",
        "base.blue.light": "#93c5fd",
        "base.yellow": "#facc15",
        "base.yellow.light": "#fde047",
        "base.magenta": "#c084fc",
