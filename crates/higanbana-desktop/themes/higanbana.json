        "primary.active.background": "#c81f31",
        "primary.foreground": "#ffffff",

        "secondary.background": "#18181f",
        "secondary.hover.background": "#1f1f28",
        "secondary.active.background": "#26262f",
        "secondary.foreground": "#ededef",

        "group_box.background": "#111118",
        "group_box.foreground": "#ededef",
        "popover.background": "#111118",
        "popover.foreground": "#ededef",
