        "selection.background": "#e8283c59",
        "overlay": "#00000099",
        "window.border": "#ffffff14",

        "accent.background": "#ffffff0f",
        "accent.foreground": "#ededef",
        "muted.background": "#18181f",
        "muted.foreground": "#9a9ea8",

        "primary.background": "#e8283c",
