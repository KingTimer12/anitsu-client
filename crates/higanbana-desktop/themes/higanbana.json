        "list.active.background": "#e8283c26",
        "list.active.border": "#e8283c",
        "list.even.background": "#ffffff05",
        "list.head.background": "#0b0b10",

        "sidebar.background": "#0b0b10",
        "sidebar.foreground": "#ededef",
        "sidebar.border": "#ffffff14",
        "sidebar.accent.background": "#ffffff0f",
        "sidebar.accent.foreground": "#ffffff",
        "sidebar.primary.background": "#e8283c",
